---
interface Props {
  h1: string;
  badge: string;
  headline: string;
  subheadline: string;
  audience: string;
  affiliateUrl: string;
  ctaText?: string;
  authoritySignals?: string[];
}

const {
  h1,
  badge,
  headline,
  subheadline,
  audience,
  affiliateUrl,
  ctaText = "Fast-Track Monetization Now →",
  authoritySignals = [
    "Turnkey Handover in 24-48h",
    "Zero Camera or Filming Required",
    "Verified Buyer Escrow Protection",
    "100% Google / Platform Compliant"
  ]
} = Astro.props;
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-gray-800 bg-gradient-to-b from-gray-900 to-gray-950">
  <!-- Glow Accent -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-brand-500/10 blur-3xl pointer-events-none -z-10 rounded-full"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Above The Fold Intent Verification -->
    <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-300 text-xs sm:text-sm font-semibold mb-6">
      <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
      <span>{badge} • Engineered for {audience}</span>
    </div>

    <!-- Strictly ONE H1 Per Page (Defensive SEO Rule) -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
      {h1}
    </h1>

    <!-- Above-The-Fold Value Confirmation -->
    <p class="text-lg sm:text-xl md:text-2xl text-slate-300 font-medium max-w-3xl mx-auto mb-8 leading-relaxed">
      {headline}. <span class="text-slate-400 text-base sm:text-lg block mt-2">{subheadline}</span>
    </p>

    <!-- Immediate High-Intent CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a
        href={affiliateUrl}
        rel="nofollow noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold rounded-xl bg-gradient-to-r from-brand-500 via-indigo-500 to-accent-500 text-white hover:from-brand-400 hover:to-accent-400 transition-all shadow-xl shadow-brand-500/25 active:scale-95"
      >
        <span>{ctaText}</span>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a
        href="#economics"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 text-base font-semibold rounded-xl bg-gray-900 hover:bg-gray-800 text-slate-200 border border-gray-700 transition-colors"
      >
        View Economics & Verification
      </a>
    </div>

    <!-- Authority Signals -->
    <div class="pt-6 border-t border-gray-800/80 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-slate-400 font-medium">
      {authoritySignals.map((signal) => (
        <div class="inline-flex items-center space-x-2">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span>{signal}</span>
        </div>
      ))}
    </div>

  </div>
</section>
