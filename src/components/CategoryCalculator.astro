    {categorySlug === 'creator-commerce' && (
      <div id="commerce-calc-container" class="rounded-3xl border border-brand-500/30 bg-gray-900/90 p-6 sm:p-10 shadow-2xl backdrop-blur">
        <div class="text-center max-w-2xl mx-auto mb-10">
