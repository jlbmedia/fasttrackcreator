          </div>

          <!-- Results Summary Column -->
          <div class="lg:col-span-5 p-6 rounded-2xl bg-gray-950/90 border border-gray-800 flex flex-col justify-between space-y-5">
            <div class="space-y-4">
              <div class="p-3.5 rounded-xl bg-gray-900 border border-gray-800">
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Net Fanvue Creator Payout (80%)</div>
                <div id="vc-res-net" class="text-2xl sm:text-3xl font-black text-emerald-400 mt-1 font-mono">$2,496.00/mo</div>
