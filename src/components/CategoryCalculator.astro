---
interface Props {
  categorySlug: string;
}

const { categorySlug } = Astro.props;
---

<section class="py-16 md:py-20 border-b border-gray-800 bg-gradient-to-b from-gray-950 via-gray-900 to-gray-950">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    {categorySlug === 'turnkey-assets' && (
      <div id="turnkey-calc-container" class="rounded-3xl border border-brand-500/30 bg-gray-900/90 p-6 sm:p-10 shadow-2xl backdrop-blur">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 border border-brand-500/30 text-brand-300 mb-3">
            Interactive Cash Flow Model
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">
            Media Asset Payback & AdSense Calculator
          </h2>
          <p class="text-xs sm:text-sm text-slate-300">
            Calculate your estimated break-even period and annual AdSense cash flow when acquiring pre-monetized digital real estate.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Controls Column -->
          <div class="lg:col-span-7 space-y-6">
            <div>
              <div class="flex justify-between text-xs sm:text-sm font-bold text-slate-200 mb-2">
                <label for="tk-cost">Acquisition Cost (Channel / Asset)</label>
                <span id="tk-cost-val" class="text-brand-400 font-mono">$700</span>
              </div>
              <input
                id="tk-cost"
                type="range"
                min="250"
                max="3500"
                step="50"
                value="700"
                class="w-full h-2 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-brand-500"
              />
              <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                <span>$250 (Starter)</span>
                <span>$1,500</span>
                <span>$3,500 (Authority)</span>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs sm:text-sm font-bold text-slate-200 mb-2">
                <label for="tk-views">Estimated Monthly Long-Form Views</label>
                <span id="tk-views-val" class="text-brand-400 font-mono">60,000</span>
              </div>
              <input
                id="tk-views"
                type="range"
                min="10000"
                max="500000"
                step="5000"
                value="60000"
                class="w-full h-2 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-brand-500"
              />
              <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                <span>10k Views</span>
                <span>150k Views</span>
                <span>500k Views</span>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs sm:text-sm font-bold text-slate-200 mb-2">
                <label for="tk-rpm">Niche RPM (Revenue Per 1,000 Views)</label>
                <span id="tk-rpm-val" class="text-emerald-400 font-mono">$12.00</span>
              </div>
              <input
                id="tk-rpm"
                type="range"
                min="2"
                max="35"
                step="0.5"
                value="12"
                class="w-full h-2 bg-gray-800 rounded-lg appearance-none cursor-pointer accent-emerald-500"
              />
              <div class="flex justify-between text-[11px] text-slate-400 mt-1">
                <span>$2 (Memes/Gaming)</span>
                <span>$12 (Tech/Biz)</span>
                <span>$35 (Finance/SaaS)</span>
              </div>
            </div>
          </div>

          <!-- Results Summary Column -->
          <div class="lg:col-span-5 p-6 rounded-2xl bg-gray-950/90 border border-gray-800 flex flex-col justify-between space-y-5">
            <div class="space-y-4">
              <div class="p-3.5 rounded-xl bg-gray-900 border border-gray-800">
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Monthly AdSense Cash Flow</div>
                <div id="tk-res-monthly" class="text-2xl sm:text-3xl font-black text-emerald-400 mt-1 font-mono">$720.00</div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="p-3 rounded-xl bg-gray-900 border border-gray-800">
                  <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Payback Time</div>
                  <div id="tk-res-payback" class="text-lg font-bold text-brand-300 mt-1 font-mono">1.0 Mos</div>
                </div>
                <div class="p-3 rounded-xl bg-gray-900 border border-gray-800">
                  <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Annual ROI</div>
                  <div id="tk-res-roi" class="text-lg font-bold text-cyan-300 mt-1 font-mono">1,234%</div>
                </div>
              </div>
            </div>

            <div class="space-y-2.5 pt-2">
              <a
                href="/go/fameswap"
                rel="nofollow noopener noreferrer"
                class="w-full text-center block px-4 py-2.5 text-xs font-bold rounded-xl bg-brand-500 text-white hover:bg-brand-400 transition-colors shadow-lg shadow-brand-500/20"
              >
                Browse Channels on Fameswap →
              </a>
              <a
                href="/go/dfy-videos"
                rel="nofollow noopener noreferrer"
                class="w-full text-center block px-4 py-2.5 text-xs font-bold rounded-xl bg-gray-800 text-slate-200 hover:bg-gray-700 hover:text-white transition-colors"
              >
                Order DFY YouTube Video Packs →
              </a>
            </div>
          </div>
        </div>
      </div>
