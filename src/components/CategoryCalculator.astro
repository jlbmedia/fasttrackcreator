</section>

<script is:inline>
  function initCalculators() {
    let gaDebounceTimer = null;
    function trackCalculatorInteraction(toolName, details) {
      if (typeof window.gtag === 'function') {
        clearTimeout(gaDebounceTimer);
        gaDebounceTimer = setTimeout(() => {
          window.gtag('event', 'calculator_interact', {
            event_category: 'dwell_engagement',
            calculator_name: toolName,
            interaction_details: details,
            source_path: window.location.pathname
          });
        }, 1200);
      }
    }

    // 1. Turnkey Assets Calculator
    const tkCost = document.getElementById('tk-cost');
    const tkViews = document.getElementById('tk-views');
    const tkRpm = document.getElementById('tk-rpm');
    if (tkCost && tkViews && tkRpm) {
      function updateTurnkey(isUserChange) {
        const cost = parseFloat(tkCost.value);
        const views = parseFloat(tkViews.value);
        const rpm = parseFloat(tkRpm.value);

        document.getElementById('tk-cost-val').textContent = '$' + cost.toLocaleString();
        document.getElementById('tk-views-val').textContent = views.toLocaleString();
        document.getElementById('tk-rpm-val').textContent = '$' + rpm.toFixed(2);

        const monthlyAdSense = (views / 1000) * rpm;
        const paybackMonths = cost / (monthlyAdSense || 1);
        const annualRoi = ((monthlyAdSense * 12) / cost) * 100;

        document.getElementById('tk-res-monthly').textContent = '$' + monthlyAdSense.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('tk-res-payback').textContent = paybackMonths < 0.1 ? '< 0.1 Mos' : paybackMonths.toFixed(1) + ' Mos';
        document.getElementById('tk-res-roi').textContent = Math.round(annualRoi).toLocaleString() + '%';

        if (isUserChange === true) {
          trackCalculatorInteraction('turnkey-assets-calc', `views:${views},cost:${cost},rpm:${rpm}`);
        }
      }
      [tkCost, tkViews, tkRpm].forEach(el => el.addEventListener('input', () => updateTurnkey(true)));
      updateTurnkey(false);
    }

    // 2. Creator Commerce Calculator
    const ccSpend = document.getElementById('cc-spend');
    const ccSkool = document.getElementById('cc-skool');
    const ccSales = document.getElementById('cc-sales');
    if (ccSpend && ccSkool && ccSales) {
      function updateCommerce(isUserChange) {
        const spend = parseFloat(ccSpend.value);
        const skoolRefs = parseFloat(ccSkool.value);
        const sales = parseFloat(ccSales.value);

        document.getElementById('cc-spend-val').textContent = '$' + spend + '/mo';
        document.getElementById('cc-skool-val').textContent = skoolRefs + (skoolRefs === 1 ? ' Group' : ' Groups');
        document.getElementById('cc-sales-val').textContent = '$' + sales.toLocaleString() + '/mo';

        const skoolMrr = skoolRefs * 39.60;
        const skoolAnnual = skoolMrr * 12;
        // Switching to LinkStack free ($0) or growth ($24.92) compared to spend
        const annualSaved = Math.max(0, (spend - 24.92) * 12);
        const totalValue = skoolAnnual + annualSaved;

        document.getElementById('cc-res-skool-mrr').textContent = '$' + skoolMrr.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '/mo';
        document.getElementById('cc-res-saved').textContent = '$' + Math.round(annualSaved).toLocaleString() + '/yr';
        document.getElementById('cc-res-total').textContent = '$' + Math.round(totalValue).toLocaleString();

        if (isUserChange === true) {
          trackCalculatorInteraction('creator-commerce-calc', `skoolRefs:${skoolRefs},spend:${spend}`);
        }
      }
      [ccSpend, ccSkool, ccSales].forEach(el => el.addEventListener('input', () => updateCommerce(true)));
      updateCommerce(false);
    }

    // 3. Virtual Creators Calculator
    const vcPersonas = document.getElementById('vc-personas');
    const vcSubs = document.getElementById('vc-subs');
    const vcPrice = document.getElementById('vc-price');
    if (vcPersonas && vcSubs && vcPrice) {
      function updateVirtual(isUserChange) {
        const personas = parseFloat(vcPersonas.value);
        const subs = parseFloat(vcSubs.value);
        const price = parseFloat(vcPrice.value);

        document.getElementById('vc-personas-val').textContent = personas + (personas === 1 ? ' Model' : ' Models');
        document.getElementById('vc-subs-val').textContent = subs.toLocaleString() + ' Subs';
        document.getElementById('vc-price-val').textContent = '$' + price.toFixed(2) + '/mo';

        // Subscriptions + estimated 30% PPV add-on per subscriber ($12 avg purchase)
        const subGross = personas * subs * price;
        const ppvGross = personas * (subs * 0.35) * 15;
        const totalGross = subGross + ppvGross;
        const netFanvue = totalGross * 0.80; // 80% creator take
        const annualNet = netFanvue * 12;
        const assetValue = annualNet * 2.5; // typical media asset multiple

        document.getElementById('vc-res-net').textContent = '$' + netFanvue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '/mo';
        document.getElementById('vc-res-asset').textContent = '~$' + Math.round(assetValue).toLocaleString();

        if (isUserChange === true) {
          trackCalculatorInteraction('virtual-creators-calc', `personas:${personas},subs:${subs},price:${price}`);
        }
      }
      [vcPersonas, vcSubs, vcPrice].forEach(el => el.addEventListener('input', () => updateVirtual(true)));
      updateVirtual(false);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCalculators);
  } else {
    initCalculators();
  }
</script>
