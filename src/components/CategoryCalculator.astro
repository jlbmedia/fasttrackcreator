    {categorySlug === 'reviews' && (
      <div id="reviews-audit-container" class="rounded-3xl border border-brand-500/30 bg-gray-900/90 p-6 sm:p-10 shadow-2xl backdrop-blur">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 border border-brand-500/30 text-brand-300 mb-3">
            2026 Platform Verification
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-2">
            Creator Platform Safety & Fee Benchmark
          </h2>
          <p class="text-xs sm:text-sm text-slate-300">
            Compare transaction surcharges, escrow protections, and affiliate revenue share across audited partners.
          </p>
