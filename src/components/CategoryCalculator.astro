        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-gray-950/80 border border-gray-800 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-brand-400 uppercase tracking-wider">Account Market</span>
                <span class="text-xs font-bold text-emerald-400">Escrow Safe</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Fameswap</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Full buyer escrow holding, OGE verification, and YouTube Brand Account mediation. 20% flat seller fee.
              </p>
            </div>
            <a href="/go/fameswap" rel="nofollow noopener noreferrer" class="text-xs font-bold text-brand-400 hover:text-brand-300 transition-colors flex items-center justify-between pt-3 border-t border-gray-800">
              <span>View Escrow Terms</span>
              <span>→</span>
            </a>
          </div>

          <div class="p-6 rounded-2xl bg-gray-950/80 border border-gray-800 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Store & DMs</span>
                <span class="text-xs font-bold text-emerald-400">0% Platform Fee</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">LinkStack</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
