                <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                <span>Flippa / Public Forums</span>
              </td>
              <td class="p-4 sm:p-5 text-slate-400">Unvetted Channel Listings</td>
              <td class="p-4 sm:p-5 text-rose-400">Minimal / Direct PayPal</td>
              <td class="p-4 sm:p-5 text-slate-400">Unverified Bot Hours</td>
              <td class="p-4 sm:p-5 text-rose-400">Extreme (Seller Password Recovery)</td>
