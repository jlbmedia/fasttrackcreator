              <td class="p-4 sm:p-5 text-slate-300">0% Surcharge</td>
              <td class="p-4 sm:p-5 text-rose-400">None (Requires ManyChat)</td>
              <td class="p-4 sm:p-5 text-rose-400">In-App Webview Leaks</td>
              <td class="p-4 sm:p-5 text-slate-400">20% Capped</td>
              <td class="p-4 sm:p-5 text-right text-slate-500">Legacy</td>
            </tr>
            <tr class="hover:bg-gray-800/40 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-slate-400">Kajabi</td>
