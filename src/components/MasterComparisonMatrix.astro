---
interface Props {
  categorySlug: string;
}

const { categorySlug } = Astro.props;
---

<section class="py-16 md:py-20 border-b border-gray-800 bg-gray-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs sm:text-sm font-bold text-brand-400 uppercase tracking-widest mb-2 block">
        Side-by-Side Architectural Audit
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-4">
        {categorySlug === 'turnkey-assets' && "Turnkey Media Asset Acquisition Benchmark"}
        {categorySlug === 'creator-commerce' && "Creator Commerce, Storefront & Community Matrix"}
        {categorySlug === 'virtual-creators' && "Virtual Creator Systems & Subscription Platform Matrix"}
        {categorySlug === 'reviews' && "2026 Master Platform Safety & Legitimacy Scorecard"}
      </h2>
      <p class="text-xs sm:text-sm text-slate-400">
        Objective data points comparing pricing, platform fees, buyer escrow protections, and monetization speed.
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-gray-800 shadow-2xl bg-gray-900/60">
      {categorySlug === 'turnkey-assets' && (
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-gray-800 bg-gray-950/90 text-slate-300 font-bold uppercase tracking-wider text-[11px]">
              <th class="p-4 sm:p-5">Platform / Method</th>
              <th class="p-4 sm:p-5">Primary Asset</th>
              <th class="p-4 sm:p-5">Escrow Protection</th>
              <th class="p-4 sm:p-5">YPP Pre-Enrollment</th>
              <th class="p-4 sm:p-5">Demonetization Risk</th>
              <th class="p-4 sm:p-5 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/80">
            <tr class="hover:bg-gray-800/40 transition-colors bg-brand-500/5">
              <td class="p-4 sm:p-5 font-bold text-white flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>Fameswap Marketplace</span>
              </td>
              <td class="p-4 sm:p-5 text-slate-300">YouTube, TikTok & IG Accounts</td>
              <td class="p-4 sm:p-5 font-bold text-emerald-400">Full Escrow + OGE Transfer</td>
              <td class="p-4 sm:p-5 text-slate-300">Audited Monetized Listings</td>
              <td class="p-4 sm:p-5 text-slate-300">Low (Verified Analytics)</td>
              <td class="p-4 sm:p-5 text-right">
                <a href="/go/fameswap" rel="nofollow noopener noreferrer" class="text-xs font-bold text-brand-400 hover:text-brand-300">Browse Listings →</a>
              </td>
            </tr>
            <tr class="hover:bg-gray-800/40 transition-colors bg-brand-500/5">
              <td class="p-4 sm:p-5 font-bold text-white flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span>DFY Dave (Soldi.ai)</span>
              </td>
