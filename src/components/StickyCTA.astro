---
interface Props {
  offerText?: string;
  affiliateUrl: string;
  ctaText?: string;
}

const {
  offerText = "Bypass 12 months of unpaid labor. Step directly into active cash flow.",
  affiliateUrl,
  ctaText = "Fast-Track Monetization →"
} = Astro.props;
---

<div id="sticky-bar" class="fixed bottom-0 inset-x-0 z-50 p-3 sm:p-4 bg-gray-950/95 border-t border-brand-500/30 backdrop-blur-md shadow-2xl transition-transform duration-300">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="flex items-center space-x-3 text-center sm:text-left">
      <span class="hidden sm:inline-flex w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
      <p class="text-xs sm:text-sm font-medium text-slate-200">
        <strong class="text-brand-400 font-bold">2026 Batch:</strong> {offerText}
      </p>
    </div>

    <div class="flex items-center space-x-3 w-full sm:w-auto justify-center">
      <a
        href={affiliateUrl}
        rel="nofollow noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-2.5 text-xs sm:text-sm font-bold rounded-xl bg-gradient-to-r from-brand-500 to-accent-500 text-white hover:from-brand-400 hover:to-accent-400 transition-all shadow-md active:scale-95"
      >
        <span>{ctaText}</span>
      </a>
    </div>
  </div>
</div>
