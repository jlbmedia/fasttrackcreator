---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqList: FAQ[];
  title?: string;
}

const {
  faqList,
  title = "Frequently Asked Questions & Due Diligence"
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-16 md:py-24 border-b border-gray-800 bg-gray-900/40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <span class="text-xs sm:text-sm font-bold text-brand-400 uppercase tracking-widest mb-2 block">
        Verification & FAQs
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
        {title}
      </h2>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      {faqList.map((faq, idx) => (
        <details class="group rounded-2xl border border-gray-800 bg-gray-900/80 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 open:border-brand-500/40 open:bg-gray-900">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-bold text-white text-base sm:text-lg">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 transition duration-300 group-open:-rotate-180 text-brand-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-gray-800/80 text-sm sm:text-base text-slate-300 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

  </div>

  <!-- Schema.org FAQPage Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
