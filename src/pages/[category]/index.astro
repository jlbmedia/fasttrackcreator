---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboveTheFoldHero from '../../components/AboveTheFoldHero.astro';
import OfferScorecard from '../../components/OfferScorecard.astro';
import CategoryCalculator from '../../components/CategoryCalculator.astro';
import MasterComparisonMatrix from '../../components/MasterComparisonMatrix.astro';
import { CATEGORIES, getAllCategories, type CategoryHub } from '../../data/categories';
import { getSpokesByCategory } from '../../data/pages';
import { getAffiliate } from '../../data/affiliates';

export async function getStaticPaths() {
  return getAllCategories().map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

interface Props {
  category: CategoryHub;
}

const { category } = Astro.props;
const spokes = getSpokesByCategory(category.slug);
const featuredAffiliates = category.featuredAffiliates
  .map(id => getAffiliate(id))
  .filter(Boolean);

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: category.name, url: `/${category.slug}/` }
];
---

<BaseLayout
  title={category.title}
  description={category.metaDescription}
  canonicalPath={`/${category.slug}/`}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <AboveTheFoldHero
    h1={category.h1}
    badge={category.badge}
    headline={category.description}
    subheadline="Browse verified operational blueprints, comparative evaluations, and instant handover shortcuts."
    audience={category.name}
    affiliateUrl="#spokes"
    ctaText="Browse Category Guides ↓"
  />

  <!-- Interactive Dwell-Time Calculator / Fee Auditor -->
  <CategoryCalculator categorySlug={category.slug} />

  <!-- Master Side-by-Side Category Benchmark Matrix -->
  <MasterComparisonMatrix categorySlug={category.slug} />

  <!-- Category Spokes Grid -->
  <section id="spokes" class="py-16 md:py-24 border-b border-gray-800 bg-gray-900/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs sm:text-sm font-bold text-accent-400 uppercase tracking-widest mb-2 block">
          In-Depth Blueprints & Audits
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-4">
          {category.name} Directory
        </h2>
        <p class="text-slate-400 text-sm sm:text-base">
          Targeted solutions engineered to accelerate monetization for specific creator archetypes.
        </p>
      </div>

      <!-- Instant Client-Side Filter -->
      <div class="max-w-xl mx-auto mb-10">
        <div class="relative">
          <input
            id="spoke-search-input"
            type="text"
            placeholder={`Filter ${category.name} guides by keyword (e.g. YouTube, pricing, DM, escrow)...`}
            class="w-full px-5 py-3.5 pl-12 rounded-2xl bg-gray-950 border border-gray-800 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all shadow-inner"
          />
          <svg class="w-5 h-5 text-slate-500 absolute left-4 top-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>

      <div id="spokes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {spokes.map((spoke) => (
          <a
            href={`/${spoke.category}/${spoke.slug}/`}
            data-spoke-card
            data-search-text={`${spoke.h1} ${spoke.metaDescription} ${spoke.badge} ${spoke.keyword}`.toLowerCase()}
            class="group p-6 sm:p-8 rounded-2xl border border-gray-800 bg-gray-900/90 hover:border-brand-500/50 hover:bg-gray-900 transition-all shadow-xl flex flex-col justify-between"
          >
            <div>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-brand-500/10 border border-brand-500/30 text-brand-300 mb-4">
                {spoke.badge}
              </span>
              <h3 class="text-lg sm:text-xl font-bold text-white mb-3 group-hover:text-brand-300 transition-colors leading-snug">
                {spoke.h1}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">
                {spoke.metaDescription}
              </p>
            </div>
            <div class="pt-4 border-t border-gray-800/80 text-xs font-bold text-accent-400 flex items-center justify-between">
              <span>Read Full Blueprint</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Featured Category Partners -->
      {featuredAffiliates.length > 0 && (
        <div>
          <div class="text-center max-w-2xl mx-auto mb-10">
            <h3 class="text-xl sm:text-3xl font-black text-white mb-2">
              Verified Partners in {category.name}
            </h3>
            <p class="text-xs sm:text-sm text-slate-400">
              Audited platforms offering active customer protection and turnkey delivery.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {featuredAffiliates.map((aff) => (
              <OfferScorecard affiliate={aff!} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    function initSearch() {
      const searchInput = document.getElementById('spoke-search-input');
      const cards = document.querySelectorAll('[data-spoke-card]');
      if (!searchInput || !cards.length) return;

      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        cards.forEach((card) => {
          const text = card.getAttribute('data-search-text') || '';
          if (!query || text.includes(query)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
  </script>
</BaseLayout>
