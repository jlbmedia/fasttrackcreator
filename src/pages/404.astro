---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCategories } from '../data/categories';

const title = "Page Not Found (404) | Fast Track Creator";
const description = "The requested page could not be found. Browse verified monetization blueprints across YouTube channels, AI influencers, and community platforms.";

const categories = getAllCategories();
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/404/"
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full text-center">
      
      <!-- 404 Badge -->
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs sm:text-sm font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
        <span>HTTP Status 404 • Page Not Found</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight mb-4">
        Looking for a Creator Fast Track?
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto mb-8">
        The link you followed has moved or is no longer active. Explore our verified acceleration hubs below to find turnkey monetized assets and software systems:
      </p>

      <!-- Category Navigation Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left mb-10">
        {categories.map((cat) => (
          <a
            href={`/${cat.slug}/`}
            class="p-4 rounded-xl bg-gray-900/80 border border-gray-800 hover:border-brand-500/50 hover:bg-gray-900 transition-all group"
          >
            <div class="text-brand-400 font-bold text-sm mb-1 group-hover:translate-x-0.5 transition-transform">
              {cat.name} →
            </div>
            <p class="text-xs text-slate-400">
              {cat.description}
            </p>
          </a>
        ))}
      </div>

      <!-- Return Home Button -->
      <a
        href="/"
        class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold rounded-xl bg-gradient-to-r from-brand-500 to-accent-500 text-white hover:from-brand-400 hover:to-accent-400 transition-all shadow-lg shadow-brand-500/20 active:scale-95"
      >
        <span>Return to Homepage</span>
      </a>

    </div>
  </div>
</BaseLayout>
