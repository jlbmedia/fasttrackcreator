---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME } from '../data/site';

const title = `Contact Us | Support Desk & Editorial Team - ${BRAND_NAME}`;
const description = "Get in touch with the Fast Track Creator team for editorial questions, audit requests, or partner inquiries. Reach our support desk directly.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Contact Us", url: "/contact/" }
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": `Contact ${BRAND_NAME}`,
  "description": description,
  "mainEntity": {
    "@type": "Organization",
    "name": BRAND_NAME,
    "url": "https://fasttrackcreator.com",
    "email": "contact@fasttrackcreator.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Support",
      "email": "contact@fasttrackcreator.com",
      "availableLanguage": "English"
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact/"
  breadcrumbs={breadcrumbs}
  schemaData={contactSchema}
>
  <div class="py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb Nav -->
    <nav class="mb-8 flex items-center space-x-2 text-xs text-gray-400">
      <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-200">Contact Us</span>
    </nav>

    <!-- Header Section (Strictly 1 H1) -->
    <header class="mb-12 border-b border-gray-800 pb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Support & Communication Desk</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Contact Fast Track Creator
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
        Have questions about our audits, requests for new platform reviews, or partnership inquiries? Our team is here to assist.
      </p>
    </header>

    <!-- Communication Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- General Inquiries -->
      <div class="p-6 rounded-2xl bg-gray-900/60 border border-gray-800 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 text-lg mb-4">
            ✉️
          </div>
          <h2 class="text-lg font-bold text-white mb-2">Direct Email Inquiries</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            For general questions, editorial corrections, or platform review inquiries, reach out directly to our central support inbox.
          </p>
        </div>
        <div class="pt-4 border-t border-gray-800/80">
          <a 
            href="mailto:contact@fasttrackcreator.com" 
            class="inline-flex items-center text-sm font-bold text-brand-400 hover:text-brand-300 transition-colors"
          >
            contact@fasttrackcreator.com →
          </a>
        </div>
      </div>

      <!-- Editorial & Vendor Audits -->
      <div class="p-6 rounded-2xl bg-gray-900/60 border border-gray-800 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-accent-500/10 border border-accent-500/20 flex items-center justify-center text-accent-400 text-lg mb-4">
            🛡️
          </div>
          <h2 class="text-lg font-bold text-white mb-2">Vendor & Audit Submissions</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Represent a marketplace, software tool, or AI production pipeline? Submit your system for our independent evaluation rubric.
          </p>
        </div>
        <div class="pt-4 border-t border-gray-800/80">
          <span class="text-xs text-slate-400">Response SLA: 24–48 Business Hours</span>
        </div>
      </div>
    </div>

    <!-- Communication Policy / Response SLA -->
    <div class="p-8 rounded-2xl bg-gray-900/40 border border-gray-800 space-y-4 text-slate-300 text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">Our Communication Commitment</h2>
      <p>
        We treat inquiries with high priority. To ensure prompt handling:
      </p>
      <ul class="list-disc pl-5 space-y-2 text-slate-400 text-xs sm:text-sm">
        <li><strong>Editorial Corrections:</strong> If you spot an outdated price tier, altered escrow policy, or platform feature shift, please include the URL of the spoke page and official verification documentation. Corrections are processed within 24 hours.</li>
        <li><strong>Commercial Proposals:</strong> We do not accept sponsored reviews or pay-to-play scorecard placements. All evaluations remain strictly independent under our editorial manifesto.</li>
        <li><strong>Support Window:</strong> Inquiries sent to <a href="mailto:contact@fasttrackcreator.com" class="text-brand-400 hover:underline">contact@fasttrackcreator.com</a> are answered Monday through Friday between 9:00 AM and 6:00 PM EST.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
